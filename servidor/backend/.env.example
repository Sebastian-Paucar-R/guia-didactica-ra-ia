# Copia este archivo a backend/.env y completa los valores. backend/.env nunca se versiona (ver .gitignore);
# esta plantilla sí, con las claves vacías, para que se sepa qué hace falta configurar.

# --- Base de datos ---------------------------------------------------------
# Sin configurar: SQLite en servidor/tutor.db (desarrollo local, nada que instalar).
# En un despliegue real, PostgreSQL con el driver pg8000 (puro Python, ver app/db/session.py):
# DATABASE_URL=postgresql+pg8000://usuario:clave@host:5432/basededatos
DATABASE_URL=

# --- Firebase Authentication -------------------------------------------------
# Ruta al JSON de la cuenta de servicio (Consola de Firebase > Configuración del proyecto > Cuentas de
# servicio > Generar nueva clave privada). Nunca lo subas al repositorio (ver .gitignore: *firebase*service*
# *account*.json ya lo cubre, pero igual queda fuera de servidor/).
FIREBASE_CREDENTIALS_PATH=

# --- Modelo (Ollama) ---------------------------------------------------------
MODELO_LLM=llama3.2
MODELO_CLASIFICADOR=

# --- Cola de generación -------------------------------------------------------
LIMITE_GENERACIONES_SIMULTANEAS=2
ESPERA_MAXIMA_COLA_S=120

# --- Filtro de pertinencia / caché / perfil (valores por defecto documentados en app/core/config.py) --------
# UMBRAL_PERTINENCIA=0.62
# CACHE_UMBRAL_SIMILITUD=0.95
# PERFIL_ACTIVO=true
